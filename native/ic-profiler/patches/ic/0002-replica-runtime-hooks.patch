+
+impl HttpCostTracing<'_> {
+    fn record(
+        self,
+        context: &CanisterHttpRequestContext,
+        callback: CallbackId,
+        stage: &'static str,
+        allowance: Cycles,
+        spent: Option<CompoundCycles<HTTPOutcalls>>,
+        refund: Cycles,
+    ) {
+        let Some(manager) = self.manager else {
+            return;
+        };
+        let caller = context.request.sender;
+        if !manager.runtime_cost_tracing_enabled(caller) {
+            return;
+        }
+        let mut details = BTreeMap::from([
+            ("accounting_domain".into(), "http_service_allowance".into()),
+            ("stage".into(), stage.into()),
+            ("allowance_cycles".into(), allowance.get().to_string()),
+            (
+                "pricing_version".into(),
+                context.pricing_version.as_str().into(),
+            ),
+            (
+                "replication".into(),
+                context.replication.kind().as_str().into(),
+            ),
+            ("subnet_size".into(), context.subnet_size.get().to_string()),
+            ("callback_scope".into(), "http_subnet_callback".into()),
+            (
+                "caller_callback_id".into(),
+                context.request.sender_reply_callback.get().to_string(),
+            ),
+        ]);
+        let event =
+            |rule_id, kind, amount, nominal_cycles, details, description: &str| TracedRuntimeCost {
+                rule_id,
+                unit: RuntimeCostUnit::Cycles,
+                kind,
+                amount,
+                nominal_cycles,
+                time: Some(self.time),
+                round: self.round,
+                call_context_id: None,
+                message_id: None,
+                callback_id: Some(callback.get()),
+                payload_bytes: None,
+                instructions: None,
+                details,
+                description: description.into(),
+            };
+        if let Some(spent) = spent {
+            details.insert(
+                "reported_spend_cycles".into(),
+                spent.real().get().to_string(),
+            );
+            details.insert(
+                "spend_capped_to_allowance".into(),
+                (spent.real() > allowance).to_string(),
+            );
+            details.insert(
+                "balance_effect".into(),
+                "none_payment_was_already_transferred_with_request".into(),
+            );
+            manager.record_runtime_cost(
+                caller,
+                event(
+                    "ic.cycles.http_usage.v1",
+                    RuntimeCostKind::Debit,
+                    spent.real().min(allowance).get(),
+                    Some(spent.nominal().get()),
+                    details.clone(),
+                    "PAYG HTTP service usage settled from the prepaid replica allowance; no second liquid-balance debit",
+                ),
+            );
+        }
+        if refund.get() > 0 {
+            details.insert("balance_effect".into(), "refund_pending_routing".into());
+            manager.record_runtime_cost(
+                caller,
+                event(
+                    "ic.cycles.http_refund.v1",
+                    RuntimeCostKind::Release,
+                    refund.get(),
+                    None,
+                    details,
+                    "Unused PAYG HTTP allowance released to the Message Routing refund pool; liquid balance is credited on delivery",
+                ),
+            );
+        }
+    }
+}
