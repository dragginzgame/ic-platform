+/// The data of a message execution whose Wasm memory accesses are traced that
+/// is needed to record the execution once it has finished.
+pub struct WasmMemoryAccessTracing {
+    tracer: Arc<dyn WasmMemoryAccessTracer>,
+    canister_id: CanisterId,
+    api_type: &'static str,
+    function: String,
+    call_context_id: Option<CallContextId>,
+    time: Time,
+    module_hash: String,
+    module_hash_kind: &'static str,
+    pub memory_tracing_enabled: bool,
+    pub instruction_profiling: bool,
+    pub read_mask: bool,
+    pub write_mask: bool,
+    attempt: WasmExecutionAttempt,
+}
+
+impl WasmMemoryAccessTracing {
+    pub fn requires_code_instrumentation(&self) -> bool {
+        self.memory_tracing_enabled
+            && (self.instruction_profiling || self.read_mask || self.write_mask)
+    }
+
+    pub fn attempt_id(&self) -> u64 {
+        self.attempt.attempt_id
+    }
+
+    /// Used only when an explicitly aborted sandbox disappears before returning
+    /// its host snapshot. Zero placeholders have explicit unavailable flags.
+    pub fn finish_unavailable_abort(mut self) {
+        if !self.memory_tracing_enabled {
+            return;
+        }
+        self.attempt.status = "aborted".to_string();
+        self.attempt.memory_details_available = false;
+        self.attempt.instructions_available = false;
+        self.tracer.record(
+            self.canister_id,
+            TracedWasmExecution {
+                attempt: self.attempt,
+                api_type: self.api_type,
+                module_hash: self.module_hash,
+                module_hash_kind: self.module_hash_kind,
+                function: self.function,
+                call_context_id: self.call_context_id,
+                time: self.time,
+                instructions_executed: NumInstructions::from(0),
+                outcome: TracedWasmExecutionOutcome::Aborted,
+                trace: Default::default(),
+            },
+        );
+    }
+
+    pub fn observe_slice(&mut self, slice: &SliceExecutionOutput, event: &str) {
+        let index = self.attempt.slice_count;
+        self.attempt.slice_count = self.attempt.slice_count.saturating_add(1);
+        self.attempt.total_round_instructions += slice.executed_instructions.get() as u128;
+        if self.attempt.slices.len() < 256 {
+            self.attempt.slices.push(WasmExecutionSlice {
+                slice_index: index,
+                event: event.to_string(),
+                instructions: slice.executed_instructions.get(),
+                instruction_kind: "round_instructions".to_string(),
+            });
+        } else {
+            self.attempt.slice_details_truncated = true;
+        }
+    }
+    /// Retains execution context while either detailed memory tracing or host
+    /// cost observation is enabled for the given canister.
+    pub fn start(
+        tracer: Option<&Arc<dyn WasmMemoryAccessTracer>>,
+        canister_id: CanisterId,
+        api_type: &ApiType,
+        func_ref: &FuncRef,
+        module: &CanisterModule,
+    ) -> Option<Self> {
+        let tracer = tracer?;
+        let memory_tracing_enabled = tracer.is_tracing_enabled(canister_id);
+        if !memory_tracing_enabled && !tracer.is_runtime_cost_tracing_enabled(canister_id) {
+            return None;
+        }
+        let (instruction_profiling, read_mask, write_mask) = if memory_tracing_enabled {
+            tracer.take_memory_profile_mode(canister_id)
+        } else {
+            (false, false, false)
+        };
+        let function = match func_ref {
+            FuncRef::Method(method) => method.to_string(),
+            // The environment of a closure differs between calls, so it is
+            // omitted to keep the names of the same callback equal.
+            FuncRef::UpdateClosure(closure) | FuncRef::QueryClosure(closure) => {
+                format!("callback (table index {})", closure.func_idx)
+            }
+        };
+        Some(Self {
+            tracer: Arc::clone(tracer),
+            canister_id,
+            api_type: api_type.as_str(),
+            function,
+            call_context_id: api_type.call_context_id(),
+            time: *api_type.time(),
+            module_hash: module
+                .module_hash()
+                .iter()
+                .map(|b| format!("{b:02x}"))
+                .collect(),
+            module_hash_kind: if module.as_slice().starts_with(b"\0asm") {
+                "installed_uncompressed_sha256"
+            } else {
+                "installed_compressed_sha256"
+            },
+            memory_tracing_enabled,
+            instruction_profiling,
+            read_mask,
+            write_mask,
+            attempt: {
+                static NEXT_ATTEMPT: AtomicU64 = AtomicU64::new(1);
+                WasmExecutionAttempt {
+                    attempt_id: NEXT_ATTEMPT.fetch_add(1, Ordering::Relaxed),
+                    status: "completed".to_string(),
+                    slice_count: 0,
+                    total_round_instructions: 0,
+                    slices: Vec::with_capacity(16),
+                    slice_details_truncated: false,
+                    memory_details_available: true,
+                    instructions_available: true,
+                }
+            },
+        })
+    }
+
+    /// Records the finished message execution with the given output. Takes the
+    /// Wasm memory access trace out of the instance stats of the output.
+    pub fn finish(
+        mut self,
+        message_instruction_limit: NumInstructions,
+        output: &mut WasmExecutionOutput,
+    ) {
+        output.instance_stats.trace_attempt_id = (self.memory_tracing_enabled
+            && output.instance_stats.wasm_memory_access_trace.is_some())
+        .then_some(self.attempt.attempt_id);
+        if matches!(output.wasm_result, Err(HypervisorError::Aborted)) {
+            self.attempt.status = "aborted".to_string();
+            self.attempt.memory_details_available = false;
+        }
+        let copy_instructions = output.instance_stats.dirty_page_copy_instructions;
+        if copy_instructions > 0
+            && self
+                .tracer
+                .is_runtime_cost_tracing_enabled(self.canister_id)
+        {
+            self.tracer.record_runtime_cost(
+                self.canister_id,
+                TracedRuntimeCost {
+                    rule_id: "ic.scheduler.dirty_page_copy.v1",
+                    unit: RuntimeCostUnit::RoundInstructions,
+                    kind: RuntimeCostKind::Debit,
+                    amount: copy_instructions as u128,
+                    nominal_cycles: None,
+                    time: Some(self.time),
+                    round: None,
+                    call_context_id: self.call_context_id,
+                    message_id: None,
+                    callback_id: None,
+                    payload_bytes: None,
+                    instructions: None,
+                    details: Default::default(),
+                    description: format!(
+                        "Dirty heap-page copying after {} ({})",
+                        self.function, self.api_type
+                    ),
+                },
+            );
+        }
+        if !self.memory_tracing_enabled {
+            return;
+        }
+        // There is no trace if no Wasm code was run, e.g., because the Wasm
+        // module could not be instantiated.
+        let Some(mut trace) = output.instance_stats.wasm_memory_access_trace.take() else {
+            return;
+        };
+        if self.attempt.status == "aborted" {
+            trace.stable_pages_tracked = false;
+            trace.stable_accessed_pages.clear();
+            trace.stable_dirty_pages.clear();
+            trace.stable_memory_size = 0;
+        }
+        let outcome = match &output.wasm_result {
+            Ok(Some(WasmResult::Reply(_))) => TracedWasmExecutionOutcome::Reply,
+            Ok(Some(WasmResult::Reject(message))) => {
+                TracedWasmExecutionOutcome::Reject(message.clone())
+            }
+            Ok(None) => TracedWasmExecutionOutcome::NoResponse,
+            Err(HypervisorError::Aborted) => TracedWasmExecutionOutcome::Aborted,
+            Err(err) => TracedWasmExecutionOutcome::Error(err.to_string()),
+        };
+        let instructions_executed = NumInstructions::from(
+            message_instruction_limit
+                .get()
+                .saturating_sub(output.num_instructions_left.get()),
+        );
+        if let Some(profile) = &mut trace.instruction_profile {
+            let ledger = &mut profile.ledger;
+            ledger.reported_instructions = instructions_executed.get();
+            ledger.unexplained_instructions = ledger.reported_instructions as i128
+                - ledger.raw_instructions as i128
+                - ledger.adjustment;
+            ledger.reconciled = ledger.unexplained_instructions == 0;
+        }
+        let (module_hash, module_hash_kind) = match trace.module_hash.as_ref() {
+            Some(hash) => (hash.clone(), "installed_uncompressed_sha256"),
+            None => (self.module_hash, self.module_hash_kind),
+        };
+        self.tracer.record(
+            self.canister_id,
+            TracedWasmExecution {
+                attempt: self.attempt,
+                api_type: self.api_type,
+                module_hash,
+                module_hash_kind,
+                function: self.function,
+                call_context_id: self.call_context_id,
+                time: self.time,
+                instructions_executed,
+                outcome,
+                trace,
+            },
+        );
+    }
+}
