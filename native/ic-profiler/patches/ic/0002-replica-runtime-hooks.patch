+/// Observer-only ownership of the physical Wasm attempts belonging to one
+/// message/task/install attempt. It lives in paused host contexts, never in
+/// replicated canister state. An install has at most three Wasm stages.
+#[derive(Clone, Default)]
+pub(crate) struct ExecutionTrace(Option<Arc<ExecutionTraceInner>>);
+
+struct ExecutionTraceInner {
+    tracer: Arc<dyn WasmMemoryAccessTracer>,
+    canister_id: CanisterId,
+    logical_execution_id: Option<u64>,
+    attempts: std::sync::Mutex<Vec<(u64, bool)>>,
