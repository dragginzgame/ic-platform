+    fn rule(
+        profile: &ic_interfaces::execution_environment::WasmInstructionProfile,
+        rule_id: &str,
+    ) -> (u64, u64) {
+        profile
+            .rules
+            .iter()
+            .find(|rule| rule.rule_id == rule_id)
+            .map_or((0, 0), |rule| (rule.events, rule.instructions))
+    }
