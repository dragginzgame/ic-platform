+        .with_subnet_type(SubnetType::Application)
+        .with_config(Some(config))
+        .with_wasm_memory_access_tracer(recorder.clone())
+        .build();
+    let wasm = wat::parse_str(
+        r#"(module
+        (import "ic0" "msg_reply" (func $reply))
+        (import "ic0" "msg_reply_data_append" (func $append (param i32 i32)))
+        (memory (export "memory") 1)
+        (func (export "canister_update slow") (local $n i32)
+            (local.set $n (i32.const 2000000))
+            (loop $again
+                (local.set $n (i32.sub (local.get $n) (i32.const 1)))
+                (br_if $again (local.get $n)))
+            (i32.store (i32.const 0) (i32.const 42))
+            (call $reply))
+        (func (export "canister_query read")
+            (call $append (i32.const 0) (i32.const 4)) (call $reply)))"#,
+    )
+    .unwrap();
+    let install = |env: &super::StateMachine| {
+        let canister = env.create_canister_with_cycles(
+            None,
+            ic_types_cycles::Cycles::new(1_000_000_000_000_000),
+            None,
+        );
+        env.install_wasm_in_mode(
+            canister,
+            ic_management_canister_types_private::CanisterInstallMode::Install,
+            wasm.clone(),
+            vec![],
+        )
+        .unwrap();
+        env.set_checkpoints_enabled(false);
+        canister
+    };
+    let normal_id = install(&control);
+    let profiled_id = install(&profiled);
+    recorder.executions.lock().unwrap().clear();
+    recorder.dispositions.lock().unwrap().clear();
+    recorder.beginnings.lock().unwrap().clear();
+    let before = (
+        control.cycle_balance(normal_id),
+        profiled.cycle_balance(profiled_id),
+    );
+    let normal_message =
+        control.send_ingress(PrincipalId::new_anonymous(), normal_id, "slow", vec![]);
+    let profiled_message =
+        profiled.send_ingress(PrincipalId::new_anonymous(), profiled_id, "slow", vec![]);
+    assert!(
+        control
+            .get_latest_state()
+            .canister_state(&normal_id)
+            .unwrap()
+            .has_paused_execution()
+    );
+    assert!(
+        profiled
+            .get_latest_state()
+            .canister_state(&profiled_id)
+            .unwrap()
+            .has_paused_execution()
+    );
+    control.checkpointed_tick();
+    profiled.checkpointed_tick();
+    assert_eq!(
+        control.await_ingress(normal_message, 100),
+        profiled.await_ingress(profiled_message.clone(), 100)
+    );
+    assert_eq!(
+        before.0 - control.cycle_balance(normal_id),
+        before.1 - profiled.cycle_balance(profiled_id)
+    );
+    assert_eq!(
+        control.query(normal_id, "read", vec![]).unwrap(),
+        profiled.query(profiled_id, "read", vec![]).unwrap()
+    );
+    for _ in 0..100 {
+        if recorder
+            .executions
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|execution| execution.attempt.status == "aborted")
+        {
+            break;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    let executions = recorder.executions.lock().unwrap();
+    let attempts: Vec<_> = executions
+        .iter()
+        .filter(|execution| execution.function == "canister_update slow")
+        .collect();
+    assert_eq!(
+        attempts.len(),
+        2,
+        "checkpoint abort plus one completed retry"
+    );
+    let aborted = attempts
+        .iter()
+        .find(|execution| execution.attempt.status == "aborted")
+        .unwrap();
+    let completed = attempts
+        .iter()
+        .find(|execution| execution.attempt.status == "completed")
+        .unwrap();
+    assert_ne!(aborted.attempt.attempt_id, completed.attempt.attempt_id);
+    assert!(aborted.attempt.slice_count > 0);
+    assert!(completed.attempt.slice_count > 1);
+    assert!(
+        aborted
+            .trace
+            .instruction_profile
+            .as_ref()
+            .unwrap()
+            .ledger
+            .raw_instructions
+            > 0
+    );
+    for execution in &attempts {
+        assert_eq!(
+            execution
+                .attempt
+                .slices
+                .iter()
+                .map(|slice| slice.instructions as u128)
+                .sum::<u128>(),
+            execution.attempt.total_round_instructions
+        );
+        assert!(
+            execution
+                .attempt
+                .slices
+                .iter()
+                .enumerate()
+                .all(|(index, slice)| slice.slice_index == index as u64)
+        );
+    }
+    let dispositions = recorder.dispositions.lock().unwrap();
+    assert_eq!(
+        dispositions[&aborted.attempt.attempt_id].state,
+        TracedExecutionState::Discarded
+    );
+    assert_eq!(
+        dispositions[&completed.attempt.attempt_id].state,
+        TracedExecutionState::Committed
+    );
+    assert_eq!(
+        dispositions[&aborted.attempt.attempt_id].logical_execution_id,
+        dispositions[&completed.attempt.attempt_id].logical_execution_id
+    );
+    let beginnings = recorder.beginnings.lock().unwrap();
+    let message_identity = format!("ingress:{profiled_message}");
+    let starts: Vec<_> = beginnings
+        .iter()
+        .filter(|(_, context)| context.identity == message_identity)
+        .collect();
+    assert_eq!(starts.len(), 2);
+    assert_eq!(starts[0].0, starts[1].0);
+    assert!(!starts[0].1.retry && starts[1].1.retry);
+    let query = executions
+        .iter()
+        .find(|execution| execution.function == "canister_query read")
+        .unwrap();
+    assert_eq!(
+        dispositions[&query.attempt.attempt_id].state,
+        TracedExecutionState::NotApplicable
+    );
+}
