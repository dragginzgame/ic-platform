+    instance
+        .run(FuncRef::Method(WasmMethod::Update("test".to_string())))
+        .unwrap();
+
+    let trace = instance
+        .get_stats()
+        .wasm_memory_access_trace
+        .expect("Expected a Wasm memory access trace");
+    assert_eq!(trace.accessed_pages, vec![0..3, 5..6]);
+    assert_eq!(trace.dirty_pages, vec![1..3]);
+    assert!(trace.dirty_pages_tracked);
+    assert_eq!(trace.wasm_memory_size, 8);
+    // 4 accessed and 2 dirty Wasm pages of 16 OS pages each.
+    assert_eq!(
+        trace.page_access_instructions,
+        (4 + 2) * OS_PAGES_PER_WASM_PAGE as u64 * 100
+    );
