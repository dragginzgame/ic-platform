+/// Observation stays outside replicated state and never changes how allowances
+/// are settled. A released allowance enters the refund pool; it has not yet
+/// been credited to the caller's liquid balance.
+#[derive(Clone, Copy)]
+struct HttpCostTracing<'a> {
+    manager: Option<&'a CyclesAccountManager>,
+    time: Time,
+    round: Option<u64>,
