+#[test]
+fn runtime_cost_execution_prepaid_and_refunded_once_without_changing_state() {
+    use ic_test_utilities_state::SystemStateBuilder;
+    for schedule in [
+        CanisterCyclesCostSchedule::Normal,
+        CanisterCyclesCostSchedule::Free,
+    ] {
+        let recorder = Arc::new(RuntimeCostRecorder::default());
+        let control = create_cycles_account_manager();
+        let profiled = control.clone().with_runtime_cost_tracer(recorder.clone());
+        let config = CyclesAccountManagerSubnetConfig::new(13, schedule, 13);
+        let mut normal_state = SystemStateBuilder::new().build();
+        let mut profiled_state = normal_state.clone();
+        let initial_balance = normal_state.balance();
+        let counter = IntCounter::new("refund_errors", "refund errors").unwrap();
+        for (manager, state) in [
+            (&control, &mut normal_state),
+            (&profiled, &mut profiled_state),
+        ] {
+            let prepaid = manager
+                .prepay_execution_cycles(
+                    state,
+                    NumBytes::new(0),
+                    MessageMemoryUsage::ZERO,
+                    ComputeAllocation::default(),
+                    NumInstructions::new(1000),
+                    config,
+                    false,
+                    WasmExecutionMode::Wasm64,
+                )
+                .unwrap();
+            manager.refund_unused_execution_cycles(
+                state,
+                NumInstructions::new(600),
+                NumInstructions::new(1000),
+                prepaid,
+                &counter,
+                config,
+                WasmExecutionMode::Wasm64,
+                &ic_logger::replica_logger::no_op_logger(),
+            );
+        }
+        assert_eq!(profiled_state, normal_state);
+        let events = recorder.0.lock().unwrap();
+        assert_eq!(
+            events.len(),
+            2,
+            "one prepayment and one refund, no duplicate generic debit"
+        );
+        assert_eq!(events[0].kind, RuntimeCostKind::Prepayment);
+        assert_eq!(events[1].kind, RuntimeCostKind::Refund);
+        assert_eq!(events[0].nominal_cycles, Some(5_002_000));
+        assert_eq!(events[1].nominal_cycles, Some(1200));
+        assert_eq!(
+            events[0].amount - events[1].amount,
+            (initial_balance - profiled_state.balance()).get()
+        );
+        assert_eq!(
+            events[0].details["subnet_id"],
+            control.get_subnet_id().to_string()
+        );
+        assert_eq!(events[0].details["subnet_size"], "13");
+        if schedule == CanisterCyclesCostSchedule::Free {
+            assert_eq!(events[0].amount, 0);
+            assert_eq!(profiled_state.balance(), initial_balance);
+        }
+    }
+}
