+                                    originator: CANISTER_RANGE_B.start,
+                                    respondent: CANISTER_RANGE_A.start,
+                                    originator_reply_callback: CallbackId::from(99),
+                                    refund: incoming_refund,
+                                    response_payload: Payload::Data(vec![]),
+                                    deadline: CoarseTime::from_secs_since_unix_epoch(u32::MAX),
+                                }
+                                .into(),
+                                &mut (i64::MAX / 2),
+                            )
+                            .unwrap();
+                        assert!(!accepted, "Missing-canister best-effort response must drop");
+                    }
+                    state
+                });
+            let mut scheduler = Box::new(MockScheduler::new());
+            scheduler
+                .expect_execute_round()
+                .times(1)
+                .returning(|state, _, _, _, _, _, _, _| state);
+            let registry = MetricsRegistry::new();
+            let metrics = MessageRoutingMetrics::new(&registry);
+            let stream_builder = Box::new(StreamBuilderImpl::new(
+                SUBNET_1,
+                MAX_STREAM_MESSAGES,
+                TARGET_STREAM_SIZE_BYTES,
+                SYSTEM_SUBNET_STREAM_MSG_LIMIT,
+                &registry,
+                &metrics,
+                Arc::new(Mutex::new(LatencyMetrics::new_time_in_stream(&registry))),
+                log.clone(),
+            ));
+            let mut machine = StateMachineImpl::new(scheduler, demux, stream_builder, log, metrics);
+            if let Some(recorder) = recorder {
+                machine = machine.with_cycles_account_manager(Arc::new(
