+/// A same-thread diagnostic transaction. Dropping discards speculative events;
+/// committing forwards them to the bounded sink (or an enclosing transaction).
+pub struct RuntimeCostObservation {
+    active: bool,
+    _same_thread: std::marker::PhantomData<std::rc::Rc<()>>,
+}
+
+impl RuntimeCostObservation {
+    /// A failed management operation retains its already-performed work even
+    /// though its temporary balance changes are rolled back and reapplied.
+    /// Preserve the original instruction reasons and let the caller observe
+    /// the real cycle reapplication separately.
+    pub fn commit_execution_instructions(mut self) -> u128 {
+        if !self.active {
+            return 0;
+        }
+        let journal = RUNTIME_COST_JOURNALS.with(|journals| journals.borrow_mut().pop().unwrap());
+        self.active = false;
+        let mut observed = 0_u128;
+        for (canister_id, mut cost) in journal.events {
+            if cost.unit == RuntimeCostUnit::ExecutionInstructions {
+                observed = observed.saturating_add(cost.amount);
+                cost.details.insert(
+                    "operation_outcome".to_string(),
+                    "failed_work_retained".to_string(),
+                );
+                deliver_runtime_cost(&journal.observer, canister_id, cost);
+            }
+        }
+        observed
+    }
+
+    pub fn commit(mut self) {
+        if self.active {
+            let journal =
+                RUNTIME_COST_JOURNALS.with(|journals| journals.borrow_mut().pop().unwrap());
+            self.active = false;
+            for (canister_id, cost) in journal.events {
+                deliver_runtime_cost(&journal.observer, canister_id, cost);
+            }
+        }
+    }
+}
+
+impl Drop for RuntimeCostObservation {
+    fn drop(&mut self) {
+        if self.active {
+            RUNTIME_COST_JOURNALS.with(|journals| {
+                journals.borrow_mut().pop();
+            });
+        }
+    }
+}
+
+fn deliver_runtime_cost(
+    observer: &Arc<dyn WasmMemoryAccessTracer>,
+    canister_id: CanisterId,
+    cost: TracedRuntimeCost,
+) {
+    let mut pending = Some(cost);
+    RUNTIME_COST_JOURNALS.with(|journals| {
+        let mut journals = journals.borrow_mut();
+        if let Some(journal) = journals
+            .iter_mut()
+            .rev()
+            .find(|journal| Arc::ptr_eq(&journal.observer, observer))
+        {
+            let cost = pending.take().unwrap();
+            if journal.events.len() < 4096 {
+                journal.events.push((canister_id, cost));
+            } else if let Some((_, existing)) = journal.events.iter_mut().find(|(id, event)| {
+                *id == canister_id
+                    && event.rule_id == cost.rule_id
+                    && event.unit == cost.unit
+                    && event.kind == cost.kind
+            }) {
+                existing.amount = existing.amount.saturating_add(cost.amount);
+                existing.nominal_cycles = existing
+                    .nominal_cycles
+                    .zip(cost.nominal_cycles)
+                    .map(|(a, b)| a.saturating_add(b));
+                let previous_events = existing
+                    .details
+                    .get("aggregated_event_count")
+                    .and_then(|count| count.parse::<u64>().ok())
+                    .unwrap_or(1);
+                let incoming_events = cost
+                    .details
+                    .get("aggregated_event_count")
+                    .and_then(|count| count.parse::<u64>().ok())
+                    .unwrap_or(1);
+                existing.details.insert(
+                    "aggregated_event_count".to_string(),
+                    previous_events.saturating_add(incoming_events).to_string(),
+                );
+                existing
+                    .details
+                    .insert("detail_truncated".to_string(), "true".to_string());
+                existing.description =
+                    "Aggregated host costs: operation detail limit reached".to_string();
+            } else {
+                journal.dropped = journal.dropped.saturating_add(1);
+                // Retain a visible indication even if the new rule cannot be
+                // aggregated. Its unobserved amount is never called zero cost.
+                if let Some((_, event)) = journal.events.last_mut() {
+                    event.details.insert(
+                        "omitted_runtime_events".to_string(),
+                        journal.dropped.to_string(),
+                    );
+                    event
+                        .details
+                        .insert("totals_incomplete".to_string(), "true".to_string());
+                }
+            }
+        }
+    });
+    if let Some(cost) = pending {
+        profile_runtime_cost(Some(canister_id), None, &cost);
+        observer.record_runtime_cost(canister_id, cost);
+    }
+}
