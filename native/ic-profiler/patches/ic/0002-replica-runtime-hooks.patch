+/// An observer-only range hook. The caller supplies already validated addresses;
+/// it never loads guest bytes or changes the instruction counter.
+pub(super) fn memory_read_ops(
+    global_index: u32,
+    function_index: u32,
+    memory: i32,
+    address: Vec<wirm::wasmparser::Operator<'static>>,
+    length: Vec<wirm::wasmparser::Operator<'static>>,
+    path: i32,
+) -> Vec<wirm::wasmparser::Operator<'static>> {
+    use wirm::wasmparser::{BlockType, Operator::*};
+    let mut ops = vec![
+        GlobalGet { global_index },
+        If {
+            blockty: BlockType::Empty,
+        },
+        I32Const { value: memory },
+    ];
+    ops.extend(address);
+    ops.extend(length);
+    ops.extend([I32Const { value: path }, Call { function_index }, End]);
+    ops
+}
