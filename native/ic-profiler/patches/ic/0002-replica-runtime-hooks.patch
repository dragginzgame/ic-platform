+    /// Observer-only evidence for the final reporting clamp. This reads the
+    /// same slice counters as message_instructions_executed without changing
+    /// them, so an overdrawn prepaid block remains visible in the raw ledger.
+    pub(crate) fn instruction_profile_reporting(
+        &self,
+        instruction_counter: i64,
+    ) -> (u64, i128, &'static str) {
+        let unclamped = self.instructions_executed_before_current_slice as i128
+            + self.current_slice_instruction_limit as i128
+            - instruction_counter as i128;
+        let reported = self
+            .message_instructions_executed(instruction_counter)
+            .min(self.message_instruction_limit())
+            .get();
+        let adjustment = reported as i128 - unclamped;
+        let cause = if adjustment == 0 {
+            ""
+        } else if unclamped > self.message_instruction_limit().get() as i128 {
+            "message_instruction_limit_clamp"
+        } else {
+            "runtime_counter_reporting_clamp"
+        };
+        (reported, adjustment, cause)
+    }
