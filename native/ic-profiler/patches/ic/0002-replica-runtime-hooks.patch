+            let key = (canister, context.identity.clone());
+            let mut active = self.active.lock().unwrap();
+            let id = if context.retry {
+                active.get(&key).copied()
+            } else {
+                None
+            }
+            .unwrap_or_else(|| self.next.fetch_add(1, Ordering::Relaxed));
+            active.insert(key, id);
+            self.beginnings.lock().unwrap().push((id, context));
+            Some(id)
