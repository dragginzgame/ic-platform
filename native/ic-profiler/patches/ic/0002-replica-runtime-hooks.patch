+#[test]
+fn diagnostic_slice_reasons_distinguish_scheduling_yields_and_preserve_abort() {
+    use super::WasmExecutionPauseReason;
+    let reasons = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+    let captured = reasons.clone();
+    let handler = DeterministicTimeSlicingHandler::new(
+        10_000,
+        10_000,
+        1_000,
+        move |slice, paused, reason| {
+            captured
+                .lock()
+                .unwrap()
+                .push((slice.executed_instructions.get(), reason));
+            paused.abort();
+        },
+    );
+    assert_eq!(
+        handler.out_of_instructions(-5),
+        Err(HypervisorError::Aborted)
+    );
+    assert_eq!(
+        *reasons.lock().unwrap(),
+        vec![(1005, WasmExecutionPauseReason::InstructionBudget)]
+    );
+    let captured = reasons.clone();
+    let handler = DeterministicTimeSlicingHandler::new(
+        10_000,
+        10_000,
+        1_000,
+        move |slice, paused, reason| {
+            captured
+                .lock()
+                .unwrap()
+                .push((slice.executed_instructions.get(), reason));
+            paused.abort();
+        },
+    );
+    assert_eq!(
+        handler.yield_for_dirty_memory_copy(),
+        Err(HypervisorError::Aborted)
+    );
+    assert_eq!(
+        reasons.lock().unwrap()[1],
+        (1000, WasmExecutionPauseReason::DirtyPageCopy)
+    );
+}
