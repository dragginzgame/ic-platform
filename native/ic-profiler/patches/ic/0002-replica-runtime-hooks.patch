+            let control = control.unwrap();
+            let observed = observed.unwrap();
+            assert_eq!(control_instructions, observed_instructions);
+            assert_eq!(control.exported_globals, observed.exported_globals);
+            assert_eq!(
+                observed.exported_globals[0],
