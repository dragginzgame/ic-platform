+/// particular, adding imports and rewriting memory.grow must not change them.
+fn original_function_origins(
+    wasm: &[u8],
+    mem_type: WasmMemoryType,
+) -> Result<(u64, Vec<FunctionOrigins>), WasmInstrumentationError> {
+    use wirm::wasmparser::{Parser, Payload, TypeRef};
+    let mut imports = 0;
+    let mut next_origin = 0;
+    let mut functions = Vec::new();
+    let mut code_section_offset = 0;
+    let parse_error = |err: wirm::wasmparser::BinaryReaderError| {
+        WasmInstrumentationError::WasmSerializeError(WasmError::new(err.to_string()))
+    };
+    for payload in Parser::new(0).parse_all(wasm) {
