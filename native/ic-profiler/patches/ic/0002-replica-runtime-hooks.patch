+                        NumInstructions::new(5_000_000_000),
+                        SubnetType::Application,
+                        SUBNET_1,
+                        CyclesAccountManagerConfig::application_subnet(),
+                    )
+                    .with_runtime_cost_tracer(recorder),
+                ));
+            }
+            machine.execute_round(
+                state,
+                BatchBuilder::new()
+                    .batch_number(Height::new(round))
+                    .time(Time::from_nanos_since_unix_epoch(round))
