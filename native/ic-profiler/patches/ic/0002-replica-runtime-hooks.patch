+    }
+    observation.commit();
+    let events = recorder.0.lock().unwrap();
+    assert_eq!(events.len(), 4096);
+    assert_eq!(events.iter().map(|event| event.amount).sum::<u128>(), 4100);
+    assert!(events.iter().any(|event| {
+        event
+            .details
+            .get("detail_truncated")
+            .is_some_and(|value| value == "true")
