+    fn instruction_profile_observes_replacement_fees_without_counting_generated_copies() {
+        let wat = r#"
+            (module
+                (import "ic0" "stable_grow" (func $grow (param i32) (result i32)))
+                (import "ic0" "stable_read" (func $read32 (param i32 i32 i32)))
