+/// Final byte ranges are recovered from the encoded binary, never from a
+/// guessed re-encoding size. A mismatch suppresses that function's map.
+fn export_instrumented_origins(
+    wasm: &[u8],
+    tags: &[Vec<OriginTag>],
+    metadata: &mut InstructionProfilingMetadata,
+    max_ranges: usize,
+) {
+    use ic_interfaces::execution_environment::WasmInstructionOriginRange;
+    use wirm::wasmparser::{Parser, Payload, TypeRef};
+    let mut imports = 0_u32;
+    let mut local = 0_usize;
+    for payload in Parser::new(0).parse_all(wasm) {
+        let Ok(payload) = payload else {
+            metadata.origin_map_truncated = true;
+            return;
+        };
+        match payload {
+            Payload::ImportSection(reader) => {
+                for import in reader.into_imports() {
+                    match import {
+                        Ok(import) if matches!(import.ty, TypeRef::Func(_)) => imports += 1,
+                        Err(_) => metadata.origin_map_truncated = true,
+                        _ => {}
+                    }
+                }
+            }
+            Payload::CodeSectionStart { range, .. } => {
+                metadata.instrumented_code_section_offset = range.start as u64
+            }
+            Payload::CodeSectionEntry(body) => {
+                let Ok(mut reader) = body.get_operators_reader() else {
+                    metadata.origin_map_truncated = true;
+                    local += 1;
+                    continue;
+                };
+                let Some(tags) = tags.get(local) else {
+                    metadata.origin_map_truncated = true;
+                    local += 1;
+                    continue;
+                };
+                let start = metadata.instrumented_ranges.len();
+                let mut ordinal = 0;
+                let mut valid = true;
+                while !reader.eof() {
+                    let offset = reader.original_position() as u64;
+                    if reader.read().is_err() {
+                        valid = false;
+                        break;
+                    }
+                    let end = reader.original_position() as u64;
+                    let Some(tag) = tags.get(ordinal) else {
+                        valid = false;
+                        break;
+                    };
+                    ordinal += 1;
+                    let function = imports + local as u32;
+                    if let Some(last) = metadata.instrumented_ranges.last_mut()
+                        && last.instrumented_function_index == function
+                        && last.end_offset == offset
+                        && last.origin_id == tag.origin_id
+                        && last.kind == tag.kind
+                    {
+                        last.end_offset = end;
+                    } else if metadata.instrumented_ranges.len() >= max_ranges {
+                        metadata.origin_map_truncated = true;
+                    } else {
+                        metadata
+                            .instrumented_ranges
+                            .push(WasmInstructionOriginRange {
+                                instrumented_function_index: function,
+                                start_offset: offset,
+                                end_offset: end,
+                                origin_id: tag.origin_id,
+                                kind: tag.kind.to_string(),
+                            });
+                    }
+                }
+                if !valid || ordinal != tags.len() {
+                    metadata.instrumented_ranges.truncate(start);
+                    metadata.origin_map_truncated = true;
+                }
+                local += 1;
+            }
+            _ => {}
+        }
+    }
+    if local != tags.len() {
+        metadata.origin_map_truncated = true;
+    }
+}
