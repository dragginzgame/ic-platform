+#[test]
+fn test_memory_access_tracer_survives_node_restart() {
+    use ic_interfaces::execution_environment::{TracedWasmExecution, WasmMemoryAccessTracer};
+    use ic_types::CanisterId;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Default)]
+    struct Recorder(Mutex<Vec<(CanisterId, String, bool)>>);
+
+    impl WasmMemoryAccessTracer for Recorder {
+        fn is_tracing_enabled(&self, _canister_id: CanisterId) -> bool {
+            true
+        }
+
+        fn take_instruction_profile(&self, _canister_id: CanisterId) -> bool {
+            true
+        }
+
+        fn record(&self, canister_id: CanisterId, execution: TracedWasmExecution) {
+            self.0.lock().unwrap().push((
+                canister_id,
+                execution.function,
+                execution.trace.instruction_profile.is_some(),
+            ));
+        }
+    }
+
+    let recorder = Arc::new(Recorder::default());
+    let state_machine = super::StateMachineBuilder::new()
+        .with_wasm_memory_access_tracer(recorder.clone())
+        .build();
+    let canister_id = state_machine.install_canister_wat(
+        r#"(module
+          (import "ic0" "msg_reply" (func $reply))
+          (memory (export "memory") 1)
+          (func (export "canister_update touch")
+            (i32.store (i32.const 0) (i32.const 42))
+            (call $reply)))"#,
+        vec![],
+        None,
+    );
+    state_machine
+        .execute_ingress(canister_id, "touch", vec![])
+        .unwrap();
+    state_machine.checkpointed_tick();
+    state_machine.await_state_hash();
+
+    let state_machine = state_machine.restart_node();
+    state_machine
+        .execute_ingress(canister_id, "touch", vec![])
+        .unwrap();
+    let executions = recorder.0.lock().unwrap();
+    let touches = executions
+        .iter()
+        .filter(|(_, function, _)| function == "canister_update touch")
+        .collect::<Vec<_>>();
+    assert_eq!(touches.len(), 2);
+    assert!(
+        touches
+            .iter()
+            .all(|(id, _, profiled)| *id == canister_id && *profiled)
+    );
+}
