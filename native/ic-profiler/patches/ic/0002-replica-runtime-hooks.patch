+            let executions = observations.executions.lock().unwrap();
+            assert_eq!(executions.len(), 1);
+            assert_eq!(executions[0].instructions_executed.get(), 100);
+            assert_eq!(output.num_instructions_left.get(), 900);
+        }
+    }
