+/// Read the interrupted instruction pointer without allocation or unwinding.
+/// Unsupported platforms retain an explicitly unavailable origin.
+unsafe fn signal_instruction_pointer(context: *const libc::c_void) -> Option<u64> {
+    if context.is_null() {
+        return None;
+    }
+    #[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+    {
+        let context = unsafe { &*(context as *const libc::ucontext_t) };
+        return Some(context.uc_mcontext.gregs[libc::REG_RIP as usize] as u64);
+    }
+    #[cfg(all(target_os = "linux", target_arch = "aarch64"))]
+    {
+        let context = unsafe { &*(context as *const libc::ucontext_t) };
+        return Some(context.uc_mcontext.pc);
+    }
+    #[allow(unreachable_code)]
+    None
+}
+
+#[cfg(all(test, target_os = "linux", target_arch = "x86_64"))]
+mod tests {
+    #[test]
+    fn interrupted_pc_is_read_from_the_signal_context() {
+        let mut context: libc::ucontext_t = unsafe { std::mem::zeroed() };
+        context.uc_mcontext.gregs[libc::REG_RIP as usize] = 0x1234_5678;
+        assert_eq!(
+            unsafe {
+                super::signal_instruction_pointer((&context as *const libc::ucontext_t).cast())
+            },
+            Some(0x1234_5678)
+        );
+        assert_eq!(
+            unsafe { super::signal_instruction_pointer(std::ptr::null()) },
+            None
+        );
+    }
+}
