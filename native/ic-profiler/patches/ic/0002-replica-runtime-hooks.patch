+
+impl std::fmt::Debug for ExecutionTrace {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_tuple("ExecutionTrace")
+            .field(&self.0.as_ref().and_then(|trace| trace.logical_execution_id))
+            .finish()
+    }
+}
+
+impl ExecutionTrace {
+    pub(crate) fn track(&self, attempt_id: Option<u64>) {
+        if let (Some(trace), Some(attempt_id)) = (&self.0, attempt_id) {
+            let mut attempts = trace.attempts.lock().unwrap();
+            if !attempts.iter().any(|(id, _)| *id == attempt_id) {
+                // Fixed protocol stages bound this list (update: one,
+                // callback/cleanup: two, upgrade: three). Keep a defensive cap.
+                if attempts.len() < 8 {
+                    attempts.push((attempt_id, false));
+                } else {
+                    trace.tracer.record_execution_disposition(
+                        trace.canister_id,
+                        attempt_id,
+                        ic_interfaces::execution_environment::TracedExecutionDisposition {
+                            logical_execution_id: trace.logical_execution_id,
+                            state:
+                                ic_interfaces::execution_environment::TracedExecutionState::Pending,
+                            reason:
+                                "State disposition unavailable: host stage tracking limit reached"
+                                    .to_string(),
+                        },
+                    );
+                }
+            }
+        }
+    }
+
+    pub(crate) fn state(&self, attempt_id: Option<u64>, committed: bool, reason: &str) {
+        self.disposition(
+            attempt_id,
+            if committed {
+                ic_interfaces::execution_environment::TracedExecutionState::Committed
+            } else {
+                ic_interfaces::execution_environment::TracedExecutionState::Discarded
+            },
+            reason,
+        );
+    }
+
+    pub(crate) fn non_replicated(&self, attempt_id: Option<u64>, reason: &str) {
+        self.disposition(
+            attempt_id,
+            ic_interfaces::execution_environment::TracedExecutionState::NotApplicable,
+            reason,
+        );
+    }
+
+    fn disposition(
+        &self,
+        attempt_id: Option<u64>,
+        state: ic_interfaces::execution_environment::TracedExecutionState,
+        reason: &str,
+    ) {
+        self.track(attempt_id);
+        if let (Some(trace), Some(attempt_id)) = (&self.0, attempt_id) {
+            let mut attempts = trace.attempts.lock().unwrap();
+            if let Some((_, settled)) = attempts.iter_mut().find(|(id, _)| *id == attempt_id) {
+                if *settled {
+                    return;
+                }
+                *settled = true;
+                trace.tracer.record_execution_disposition(
+                    trace.canister_id,
+                    attempt_id,
+                    ic_interfaces::execution_environment::TracedExecutionDisposition {
+                        logical_execution_id: trace.logical_execution_id,
+                        state,
+                        reason: reason.to_string(),
+                    },
+                );
+            }
+        }
+    }
+
+    pub(crate) fn settle(&self, committed: bool, reason: &str) {
+        let pending = self
+            .0
+            .as_ref()
+            .map(|trace| {
+                trace
+                    .attempts
+                    .lock()
+                    .unwrap()
+                    .iter()
+                    .filter_map(|(id, settled)| (!settled).then_some(*id))
+                    .collect::<Vec<_>>()
+            })
+            .unwrap_or_default();
+        for id in pending {
+            self.state(Some(id), committed, reason);
+        }
+    }
+
+    pub(crate) fn finish(&self, retry: bool) {
+        if let Some(trace) = &self.0
+            && let Some(logical_id) = trace.logical_execution_id
+        {
+            trace
+                .tracer
+                .finish_logical_execution(trace.canister_id, logical_id, retry);
+        }
+    }
+
+    pub(crate) fn abort(&self, attempt_id: Option<u64>) {
+        self.track(attempt_id);
+        self.settle(
+            false,
+            "DTS attempt aborted; its provisional Wasm state is discarded",
+        );
+        self.finish(true);
+    }
+}
