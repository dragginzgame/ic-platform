+    if has_writes {
+        body.locals.extend([
+            (3, address_type),
+            (2, DataType::I32),
+            (1, DataType::I64),
+            (1, DataType::F32),
+            (1, DataType::F64),
+            (1, DataType::V128),
+        ]);
+        body.num_locals += 9;
+    }
+    let added = ops.len() - original_len;
+    body.num_instructions = ops.len();
+    *body.instructions.get_ops_mut().expect("unencoded body") = ops;
+    *tags = output_tags;
