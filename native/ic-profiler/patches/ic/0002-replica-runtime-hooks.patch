+/// Observe logical original Wasm reads after they complete successfully. This
+/// runs after metering and before stable replacements, so internal bytemap
+/// loads, observer code and stable-copy implementation reads are excluded.
+fn inject_memory_reads(
+    body: &mut wirm::ir::types::Body,
+    num_params: u32,
+    mem_type: WasmMemoryType,
+    counters: &InjectedCounters,
+    functions: &InjectedFunctions,
+    tags: &mut Vec<OriginTag>,
+) -> u64 {
+    use wirm::wasmparser::Operator::*;
+    let (Some(global), Some(observer)) = (counters.read_mask_enabled, functions.memory_read) else {
+        return 0;
+    };
+    let address_type = match mem_type {
+        WasmMemoryType::Wasm32 => DataType::I32,
+        WasmMemoryType::Wasm64 => DataType::I64,
+    };
+    let address_local = num_params + body.locals.iter().map(|v| v.0).sum::<u32>();
+    let length_local = address_local + 1;
+    let vector_local = address_local + 2;
+    let original = std::mem::take(body.instructions.get_ops_mut().expect("unencoded body"));
+    let original_len = original.len();
+    let mut ops = Vec::with_capacity(original_len);
+    let mut output_tags = Vec::with_capacity(original_len);
+    let mut has_reads = false;
+    let append =
+        |output: &mut Vec<_>, output_tags: &mut Vec<_>, values: Vec<_>, tag: OriginTag| {
+            output_tags.resize(
+                output_tags.len() + values.len(),
+                OriginTag {
+                    origin_id: tag.origin_id,
+                    kind: "memory_read_observer",
+                },
+            );
+            output.extend(values);
+        };
+    for (operator, tag) in original.into_iter().zip(std::mem::take(tags)) {
+        let load = if tag.kind == "original" {
+            match &operator {
+                I32Load { memarg } | F32Load { memarg } => Some((*memarg, 4, false)),
+                I64Load { memarg } | F64Load { memarg } => Some((*memarg, 8, false)),
+                I32Load8S { memarg }
+                | I32Load8U { memarg }
+                | I64Load8S { memarg }
+                | I64Load8U { memarg } => Some((*memarg, 1, false)),
+                I32Load16S { memarg }
+                | I32Load16U { memarg }
+                | I64Load16S { memarg }
+                | I64Load16U { memarg } => Some((*memarg, 2, false)),
+                I64Load32S { memarg } | I64Load32U { memarg } => Some((*memarg, 4, false)),
+                V128Load { memarg } => Some((*memarg, 16, false)),
+                V128Load8x8S { memarg }
+                | V128Load8x8U { memarg }
+                | V128Load16x4S { memarg }
+                | V128Load16x4U { memarg }
+                | V128Load32x2S { memarg }
+                | V128Load32x2U { memarg }
+                | V128Load64Splat { memarg }
+                | V128Load64Zero { memarg } => Some((*memarg, 8, false)),
+                V128Load8Splat { memarg } => Some((*memarg, 1, false)),
+                V128Load16Splat { memarg } => Some((*memarg, 2, false)),
+                V128Load32Splat { memarg } | V128Load32Zero { memarg } => Some((*memarg, 4, false)),
+                V128Load8Lane { memarg, .. } => Some((*memarg, 1, true)),
+                V128Load16Lane { memarg, .. } => Some((*memarg, 2, true)),
+                V128Load32Lane { memarg, .. } => Some((*memarg, 4, true)),
+                V128Load64Lane { memarg, .. } => Some((*memarg, 8, true)),
+                _ => None,
+            }
+        } else {
+            None
+        };
+        if let Some((memarg, width, lane)) = load {
+            has_reads = true;
+            let mut save = Vec::new();
+            if lane {
+                save.push(LocalSet {
+                    local_index: vector_local,
+                });
+            }
+            save.push(LocalTee {
+                local_index: address_local,
+            });
+            if lane {
+                save.push(LocalGet {
+                    local_index: vector_local,
+                });
+            }
+            append(&mut ops, &mut output_tags, save, tag);
+            ops.push(operator);
+            output_tags.push(tag);
+            let mut address = vec![LocalGet {
+                local_index: address_local,
+            }];
+            if matches!(mem_type, WasmMemoryType::Wasm32) {
+                address.push(I64ExtendI32U);
+            }
+            if memarg.offset != 0 {
+                address.extend([
+                    I64Const {
+                        value: memarg.offset as i64,
+                    },
+                    I64Add,
+                ]);
+            }
+            append(
+                &mut ops,
+                &mut output_tags,
+                memory_read_ops(
+                    global,
+                    observer,
+                    0,
+                    address,
+                    vec![I64Const { value: width }],
+                    0,
+                ),
+                tag,
+            );
+        } else if tag.kind == "original" && matches!(operator, MemoryCopy { src_mem: 0, .. }) {
+            has_reads = true;
+            append(
+                &mut ops,
+                &mut output_tags,
+                vec![
+                    LocalSet {
+                        local_index: length_local,
+                    },
+                    LocalSet {
+                        local_index: address_local,
+                    },
+                    LocalGet {
+                        local_index: address_local,
+                    },
+                    LocalGet {
+                        local_index: length_local,
+                    },
+                ],
+                tag,
+            );
+            ops.push(operator);
+            output_tags.push(tag);
+            let mut address = vec![LocalGet {
+                local_index: address_local,
+            }];
+            let mut length = vec![LocalGet {
+                local_index: length_local,
+            }];
+            if matches!(mem_type, WasmMemoryType::Wasm32) {
+                address.push(I64ExtendI32U);
+                length.push(I64ExtendI32U);
+            }
+            append(
+                &mut ops,
+                &mut output_tags,
+                memory_read_ops(global, observer, 0, address, length, 0),
+                tag,
+            );
+        } else {
+            ops.push(operator);
+            output_tags.push(tag);
+        }
+    }
+    if has_reads {
+        body.locals.extend([(2, address_type), (1, DataType::V128)]);
+        body.num_locals += 3;
+    }
+    let added = ops.len() - original_len;
+    body.num_instructions = ops.len();
+    *body.instructions.get_ops_mut().expect("unencoded body") = ops;
+    *tags = output_tags;
+    added as u64
+}
