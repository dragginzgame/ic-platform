+                subnet_config.cycles_account_manager_config.$field.get().to_string());
+        })+};
+    }
+    cycles!(
+        canister_creation_fee,
+        update_message_execution_fee,
+        ten_update_instructions_execution_fee,
+        ten_update_instructions_execution_fee_wasm64,
+        xnet_call_fee,
+        xnet_byte_transmission_fee,
+        ingress_message_reception_fee,
+        ingress_byte_reception_fee,
+        gib_storage_per_second_fee,
+        base_per_second_fee,
+        compute_percent_allocated_per_second_fee,
+        ecdsa_signature_fee,
+        schnorr_signature_fee,
+        vetkd_fee,
+        http_request_linear_baseline_fee,
+        http_request_quadratic_baseline_fee,
