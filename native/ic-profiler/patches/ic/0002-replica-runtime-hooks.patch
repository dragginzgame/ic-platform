+#[test]
+fn runtime_cost_transaction_discards_rollback_and_commits_nested_charges_once() {
+    let recorder = Arc::new(RuntimeCostRecorder::default());
+    let manager = create_cycles_account_manager().with_runtime_cost_tracer(recorder.clone());
+    let canister = ic_test_utilities_types::ids::canister_test_id(1);
+    let charge = |amount| {
+        manager.record_cycles_cost(
+            canister,
+            "ic.cycles.storage.v1",
+            RuntimeCostKind::Debit,
+            CompoundCycles::<Memory>::new(Cycles::new(amount), CanisterCyclesCostSchedule::Normal),
+            "test debit",
+        )
+    };
+    {
+        let _rolled_back = manager.defer_runtime_costs();
+        charge(11);
+    }
+    assert!(recorder.0.lock().unwrap().is_empty());
+    let outer = manager.defer_runtime_costs();
+    charge(3);
+    let inner = manager.defer_runtime_costs();
+    charge(5);
+    inner.commit();
+    assert!(recorder.0.lock().unwrap().is_empty());
+    outer.commit();
+    assert_eq!(
+        recorder
+            .0
+            .lock()
+            .unwrap()
+            .iter()
+            .map(|event| event.amount)
+            .collect::<Vec<_>>(),
+        vec![3, 5]
+    );
+    let sandbox_manager = manager.without_runtime_cost_tracer();
+    assert_eq!(sandbox_manager, create_cycles_account_manager());
+    sandbox_manager.record_cycles_cost(
+        canister,
+        "ic.cycles.storage.v1",
+        RuntimeCostKind::Debit,
+        CompoundCycles::<Memory>::new(Cycles::new(100), CanisterCyclesCostSchedule::Normal),
+        "tentative",
+    );
+    assert_eq!(recorder.0.lock().unwrap().len(), 2);
+}
