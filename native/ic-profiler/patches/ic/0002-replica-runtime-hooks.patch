+#[test]
+fn diagnostic_details_and_message_ids_are_evaluated_only_when_observed() {
+    let canister = ic_test_utilities_types::ids::canister_test_id(1);
+    let time = Time::from_nanos_since_unix_epoch(123);
+    let cycles =
+        CompoundCycles::<Instructions>::new(Cycles::new(1), CanisterCyclesCostSchedule::Normal);
+    let disabled = create_cycles_account_manager().without_runtime_cost_tracer();
+    let _context = disabled.runtime_cost_context(
+        canister,
+        time,
+        None,
+        || panic!("disabled message metadata must remain lazy"),
+        None,
+    );
+    disabled.record_cycles_cost_with_details(
+        canister,
+        "test.lazy",
+        RuntimeCostKind::Debit,
+        cycles,
+        "test",
+        || panic!("disabled charge details must remain lazy"),
+    );
+
+    let recorder = Arc::new(RuntimeCostRecorder::default());
+    let enabled = create_cycles_account_manager().with_runtime_cost_tracer(recorder.clone());
+    let calls = std::cell::Cell::new(0);
+    let _context = enabled.runtime_cost_context(
+        canister,
+        time,
+        None,
+        || {
+            calls.set(calls.get() + 1);
+            Some("request-id".to_string())
+        },
+        None,
+    );
+    enabled.record_cycles_cost_with_details(
+        canister,
+        "test.lazy",
+        RuntimeCostKind::Debit,
+        cycles,
+        "test",
+        || {
+            calls.set(calls.get() + 1);
+            std::collections::BTreeMap::from([("detail".to_string(), "retained".to_string())])
+        },
+    );
+    assert_eq!(calls.get(), 2);
+    let records = recorder.0.lock().unwrap();
+    assert_eq!(records.len(), 1);
+    assert_eq!(records[0].message_id.as_deref(), Some("request-id"));
+    assert_eq!(records[0].details["detail"], "retained");
+    assert_eq!(records[0].time, Some(time));
+}
