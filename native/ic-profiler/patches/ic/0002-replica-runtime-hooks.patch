+        let observer_log = log.clone();
+        let observer_debited = debited.clone();
+        tracker.set_page_debit_observer(Arc::new(move |kind, region, instructions| {
+            observer_log.record(
+                kind,
+                region,
+                instructions,
+                observer_debited.load(Ordering::Relaxed),
