+#[test]
+fn test_runtime_cost_profiler_reconciles_balance_and_preserves_execution() {
+    use ic_interfaces::execution_environment::{
+        RuntimeCostKind, RuntimeCostUnit, TracedRuntimeCost, TracedWasmExecution,
+        WasmMemoryAccessTracer,
+    };
+    use ic_registry_subnet_type::SubnetType;
+    use ic_types::{CanisterId, SubnetId};
+    use std::collections::BTreeMap;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Default)]
+    struct Recorder {
+        costs: Mutex<Vec<(CanisterId, TracedRuntimeCost)>>,
+        executions: Mutex<Vec<TracedWasmExecution>>,
+        subnet_costs: Mutex<Vec<TracedRuntimeCost>>,
+        configurations: Mutex<BTreeMap<SubnetId, BTreeMap<String, String>>>,
+        dispositions:
+            Mutex<BTreeMap<u64, ic_interfaces::execution_environment::TracedExecutionDisposition>>,
+    }
+    impl WasmMemoryAccessTracer for Recorder {
+        fn is_tracing_enabled(&self, _: CanisterId) -> bool {
+            true
+        }
+        fn take_instruction_profile(&self, _: CanisterId) -> bool {
+            true
+        }
+        fn record(&self, _: CanisterId, execution: TracedWasmExecution) {
+            self.executions.lock().unwrap().push(execution);
+        }
+        fn record_execution_disposition(
+            &self,
+            _: CanisterId,
+            attempt_id: u64,
+            disposition: ic_interfaces::execution_environment::TracedExecutionDisposition,
+        ) {
+            self.dispositions
+                .lock()
+                .unwrap()
+                .insert(attempt_id, disposition);
+        }
+        fn record_runtime_cost(&self, canister_id: CanisterId, cost: TracedRuntimeCost) {
+            self.costs.lock().unwrap().push((canister_id, cost));
+        }
+        fn record_subnet_runtime_cost(&self, _: SubnetId, cost: TracedRuntimeCost) {
+            self.subnet_costs.lock().unwrap().push(cost);
+        }
+        fn record_runtime_configuration(
+            &self,
+            subnet_id: SubnetId,
+            values: BTreeMap<String, String>,
+        ) {
+            self.configurations
+                .lock()
+                .unwrap()
+                .entry(subnet_id)
+                .or_default()
+                .extend(values);
+        }
+    }
+    let recorder = Arc::new(Recorder::default());
+    let control = super::StateMachineBuilder::new()
+        .with_subnet_type(SubnetType::Application)
+        .build();
+    let profiled = super::StateMachineBuilder::new()
+        .with_subnet_type(SubnetType::Application)
+        .with_wasm_memory_access_tracer(recorder.clone())
+        .build();
+    let wasm = r#"(module
+        (import "ic0" "msg_reply" (func $reply))
+        (memory (export "memory") 1)
+        (func (export "canister_update touch")
+            (i32.store (i32.const 0) (i32.const 42))
+            (call $reply)))"#;
+    let normal_id = control.create_canister_with_cycles(
+        None,
+        ic_types_cycles::Cycles::new(1_000_000_000_000_000),
+        None,
+    );
+    let profiled_id = profiled.create_canister_with_cycles(
+        None,
+        ic_types_cycles::Cycles::new(1_000_000_000_000_000),
+        None,
+    );
+    let wasm = wat::parse_str(wasm).unwrap();
+    control
+        .install_wasm_in_mode(
+            normal_id,
+            ic_management_canister_types_private::CanisterInstallMode::Install,
+            wasm.clone(),
+            vec![],
+        )
+        .unwrap();
+    profiled
+        .install_wasm_in_mode(
+            profiled_id,
+            ic_management_canister_types_private::CanisterInstallMode::Install,
+            wasm,
+            vec![],
+        )
+        .unwrap();
+    recorder.costs.lock().unwrap().clear();
+    recorder.executions.lock().unwrap().clear();
+    let normal_before = control.cycle_balance(normal_id);
+    let profiled_before = profiled.cycle_balance(profiled_id);
+    assert_eq!(
+        control.execute_ingress(normal_id, "touch", vec![]),
+        profiled.execute_ingress(profiled_id, "touch", vec![])
+    );
+    let normal_spent = normal_before - control.cycle_balance(normal_id);
+    let profiled_spent = profiled_before - profiled.cycle_balance(profiled_id);
+    assert_eq!(normal_spent, profiled_spent);
+    let costs = recorder.costs.lock().unwrap();
+    let mut debited = 0_u128;
+    let mut refunded = 0_u128;
+    for (_, cost) in costs
+        .iter()
+        .filter(|(id, cost)| *id == profiled_id && cost.unit == RuntimeCostUnit::Cycles)
+    {
+        match cost.kind {
+            RuntimeCostKind::Debit | RuntimeCostKind::Prepayment => debited += cost.amount,
+            RuntimeCostKind::Refund => refunded += cost.amount,
+            _ => panic!("unexpected fee movement in simple update: {:?}", cost),
+        }
+    }
+    assert_eq!(debited - refunded, profiled_spent);
+    assert!(
+        costs
+            .iter()
+            .any(|(_, cost)| cost.rule_id == "ic.cycles.ingress.v1")
+    );
+    assert!(
+        costs
+            .iter()
+            .any(|(_, cost)| cost.rule_id == "ic.scheduler.slice.v1"
+                && cost.unit == RuntimeCostUnit::RoundInstructions
+                && cost.amount == 2_000_000)
+    );
+    assert!(
+        recorder
+            .subnet_costs
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|cost| cost.rule_id == "ic.scheduler.finalization.v1"
+                && cost.unit == RuntimeCostUnit::RoundInstructions)
+    );
+    let executions = recorder.executions.lock().unwrap();
+    assert_eq!(executions.len(), 1);
+    assert_eq!(
+        recorder.dispositions.lock().unwrap()[&executions[0].attempt.attempt_id].state,
+        ic_interfaces::execution_environment::TracedExecutionState::Committed
+    );
+    assert!(
+        executions[0]
+            .trace
+            .instruction_profile
+            .as_ref()
+            .unwrap()
+            .ledger
+            .reconciled
+    );
+    let configurations = recorder.configurations.lock().unwrap();
+    let actual = configurations.get(&profiled.get_subnet_id()).unwrap();
+    assert_eq!(actual["cycles.update_message_execution_fee"], "5000000");
+    assert_eq!(
+        actual["scheduler.instruction_overhead_per_execution"],
+        "2000000"
+    );
+    drop(configurations);
+    drop(executions);
+    drop(costs);
+
+    // A self-call still pays request bytes, response bytes and callback work.
+    // It also exercises prepayments recorded before the callback ever exists.
+    let make_call_module = |canister_id: CanisterId| {
+        let callee = canister_id
+            .get()
+            .as_slice()
+            .iter()
+            .map(|byte| format!("\\{byte:02x}"))
+            .collect::<String>();
+        wat::parse_str(format!(
+            r#"(module
+            (import "ic0" "msg_reply" (func $reply))
+            (import "ic0" "msg_reply_data_append" (func $append_reply (param i32 i32)))
+            (import "ic0" "call_new" (func $call_new (param i32 i32 i32 i32 i32 i32 i32 i32)))
+            (import "ic0" "call_data_append" (func $append_call (param i32 i32)))
+            (import "ic0" "call_perform" (func $perform (result i32)))
+            (memory (export "memory") 1)
+            (data (i32.const 128) "{callee}")
+            (data (i32.const 32) "callee")
+            (data (i32.const 64) "abc")
+            (table 2 funcref)
+            (elem (i32.const 0) $callback $callback)
+            (func $callback (param i32) (call $reply))
+            (func (export "canister_update callee")
+                (call $append_reply (i32.const 64) (i32.const 3))
+                (call $reply))
+            (func (export "canister_update self_call")
+                (call $call_new (i32.const 128) (i32.const {callee_len})
+                    (i32.const 32) (i32.const 6) (i32.const 0) (i32.const 0)
+                    (i32.const 1) (i32.const 0))
+                (call $append_call (i32.const 64) (i32.const 3))
+                (drop (call $perform))))"#,
+            callee_len = canister_id.get().as_slice().len()
+        ))
+        .unwrap()
+    };
+    control
+        .install_wasm_in_mode(
+            normal_id,
+            ic_management_canister_types_private::CanisterInstallMode::Reinstall,
+            make_call_module(normal_id),
+            vec![],
+        )
+        .unwrap();
+    profiled
+        .install_wasm_in_mode(
+            profiled_id,
+            ic_management_canister_types_private::CanisterInstallMode::Reinstall,
+            make_call_module(profiled_id),
+            vec![],
+        )
+        .unwrap();
+    recorder.costs.lock().unwrap().clear();
+    recorder.executions.lock().unwrap().clear();
+    let normal_before = control.cycle_balance(normal_id);
+    let profiled_before = profiled.cycle_balance(profiled_id);
+    assert_eq!(
+        control.execute_ingress(normal_id, "self_call", vec![]),
+        profiled.execute_ingress(profiled_id, "self_call", vec![])
+    );
+    let normal_spent = normal_before - control.cycle_balance(normal_id);
+    let profiled_spent = profiled_before - profiled.cycle_balance(profiled_id);
+    assert_eq!(normal_spent, profiled_spent);
+    let costs = recorder.costs.lock().unwrap();
+    let billed = costs
+        .iter()
+        .filter(|(id, event)| *id == profiled_id && event.unit == RuntimeCostUnit::Cycles);
+    let (debited, refunded) =
+        billed.fold(
+            (0_u128, 0_u128),
+            |(debit, refund), (_, event)| match event.kind {
+                RuntimeCostKind::Debit | RuntimeCostKind::Prepayment => {
+                    (debit + event.amount, refund)
+                }
+                RuntimeCostKind::Refund => (debit, refund + event.amount),
+                _ => panic!("Unexpected movement in self-call: {event:?}"),
+            },
+        );
+    assert_eq!(
+        debited - refunded,
+        profiled_spent,
+        "request and callback prepayments/refunds must each appear once"
+    );
+    let request = costs
+        .iter()
+        .find(|(_, event)| event.rule_id == "ic.cycles.transmission.v1")
+        .unwrap();
+    assert_eq!(
+        request.1.payload_bytes,
+        Some(9),
+        "method name plus request payload are transmitted bytes"
+    );
+    assert!(request.1.call_context_id.is_some());
+    let response = costs
+        .iter()
+        .find(|(_, event)| {
+            event.rule_id == "ic.cycles.response_transmission.v1"
+                && event.kind == RuntimeCostKind::Refund
+        })
+        .unwrap();
+    assert_eq!(response.1.payload_bytes, Some(3));
+    assert!(response.1.callback_id.is_some());
+    assert!(
+        costs
+            .iter()
+            .any(|(_, event)| event.rule_id == "ic.cycles.execution.v1"
+                && event.kind == RuntimeCostKind::Prepayment
+                && event.message_id.is_some())
+    );
+    let executions = recorder.executions.lock().unwrap();
+    assert_eq!(executions.len(), 3);
+    let dispositions = recorder.dispositions.lock().unwrap();
+    assert!(executions.iter().all(
+        |execution| dispositions[&execution.attempt.attempt_id].state
+            == ic_interfaces::execution_environment::TracedExecutionState::Committed
+    ));
+}
