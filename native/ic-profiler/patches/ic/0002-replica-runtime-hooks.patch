+#[test]
+fn runtime_cost_failed_operation_retains_work_reasons_without_repeating_cycles() {
+    let recorder = Arc::new(RuntimeCostRecorder::default());
+    let manager = create_cycles_account_manager().with_runtime_cost_tracer(recorder.clone());
+    let canister = ic_test_utilities_types::ids::canister_test_id(1);
+    let observation = manager.defer_runtime_costs();
+    manager.record_cycles_cost(
+        canister,
+        "ic.cycles.management_instructions.v1",
+        RuntimeCostKind::Debit,
+        CompoundCycles::<Instructions>::new(Cycles::new(200), CanisterCyclesCostSchedule::Normal),
+        "tentative cycles",
+    );
+    manager.record_runtime_cost(
+        canister,
+        TracedRuntimeCost {
+            rule_id: "ic.management.chunk_upload.v1",
+            unit: RuntimeCostUnit::ExecutionInstructions,
+            kind: RuntimeCostKind::Debit,
+            amount: 200,
+            nominal_cycles: None,
+            time: None,
+            round: None,
+            call_context_id: None,
+            message_id: None,
+            callback_id: None,
+            payload_bytes: None,
+            instructions: Some(200),
+            details: Default::default(),
+            description: "Actual work retained after rollback".to_string(),
+        },
+    );
+    assert_eq!(observation.commit_execution_instructions(), 200);
+    let events = recorder.0.lock().unwrap();
+    assert_eq!(events.len(), 1);
+    assert_eq!(events[0].rule_id, "ic.management.chunk_upload.v1");
+    assert_eq!(events[0].unit, RuntimeCostUnit::ExecutionInstructions);
+    assert_eq!(
+        events[0].details["operation_outcome"],
+        "failed_work_retained"
+    );
+}
