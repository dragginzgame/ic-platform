+
+    /// Snapshot metric registry handles without waiting for an executing
+    /// instance and without gathering while holding any instance/state lock.
+    pub(crate) fn profiling_metrics_registries(
+        &self,
+        selected: Option<InstanceId>,
+    ) -> (
+        Vec<(InstanceId, String, String, ic_metrics::MetricsRegistry)>,
+        Vec<serde_json::Value>,
+    ) {
+        let mut registries = Vec::new();
+        let mut unavailable = Vec::new();
+        let Ok(instances) = self.instances.try_read() else {
+            return (
+                registries,
+                vec![serde_json::json!({"instance_id":selected,"reason":"instance_list_locked"})],
+            );
+        };
+        for (id, instance) in instances.iter().enumerate() {
+            if selected.is_some_and(|selected| selected != id) {
+                continue;
+            }
+            let Ok(instance) = instance.try_lock() else {
+                unavailable.push(serde_json::json!({"instance_id":id,"reason":"instance_locked"}));
+                continue;
+            };
+            match &instance.state {
+                InstanceState::Available(pic) => registries.extend(
+                    pic.profiling_metrics_registries()
+                        .into_iter()
+                        .map(|(subnet, generation, registry)| (id, subnet, generation, registry)),
+                ),
+                InstanceState::Busy { .. } => unavailable
+                    .push(serde_json::json!({"instance_id":id,"reason":"instance_executing"})),
+                InstanceState::Deleted => unavailable
+                    .push(serde_json::json!({"instance_id":id,"reason":"instance_deleted"})),
+            }
+        }
+        (registries, unavailable)
+    }
+
