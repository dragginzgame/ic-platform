+/// Lossless JSON encoding for trace counters and Wasm64 addresses. Older
+/// numeric trace values remain accepted when reading saved traces.
+pub mod trace_u64 {
+    use serde::{Deserialize, Deserializer, Serializer};
+
+    #[derive(Deserialize)]
+    #[serde(untagged)]
+    enum DecimalOrNumber {
+        Decimal(String),
+        Number(u64),
+    }
+
+    #[derive(Deserialize)]
+    struct Value(#[serde(deserialize_with = "deserialize")] u64);
+
+    pub fn serialize<S: Serializer>(value: &u64, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&value.to_string())
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<u64, D::Error> {
+        match DecimalOrNumber::deserialize(deserializer)? {
+            DecimalOrNumber::Decimal(value) => value.parse().map_err(serde::de::Error::custom),
+            DecimalOrNumber::Number(value) => Ok(value),
+        }
+    }
+
+    pub mod option {
+        use super::*;
+        use serde::Serialize;
+
+        pub fn serialize<S: Serializer>(
+            value: &Option<u64>,
+            serializer: S,
+        ) -> Result<S::Ok, S::Error> {
+            value.map(|value| value.to_string()).serialize(serializer)
+        }
+
+        pub fn deserialize<'de, D: Deserializer<'de>>(
+            deserializer: D,
+        ) -> Result<Option<u64>, D::Error> {
+            Ok(Option::<Value>::deserialize(deserializer)?.map(|value| value.0))
+        }
+    }
+
+    /// Retains the difference between an omitted guard and an explicit null.
+    pub mod present_option {
+        use super::*;
+
+        pub fn serialize<S: Serializer>(
+            value: &Option<Option<u64>>,
+            serializer: S,
+        ) -> Result<S::Ok, S::Error> {
+            option::serialize(&value.flatten(), serializer)
+        }
+
+        pub fn deserialize<'de, D: Deserializer<'de>>(
+            deserializer: D,
+        ) -> Result<Option<Option<u64>>, D::Error> {
+            option::deserialize(deserializer).map(Some)
+        }
+    }
+
+    pub mod ranges {
+        use super::*;
+        use serde::Serialize;
+
+        pub fn serialize<S: Serializer>(
+            value: &[(u64, u64)],
+            serializer: S,
+        ) -> Result<S::Ok, S::Error> {
+            value
+                .iter()
+                .map(|(start, end)| (start.to_string(), end.to_string()))
+                .collect::<Vec<_>>()
+                .serialize(serializer)
+        }
+
+        pub fn deserialize<'de, D: Deserializer<'de>>(
+            deserializer: D,
+        ) -> Result<Vec<(u64, u64)>, D::Error> {
+            Ok(Vec::<(Value, Value)>::deserialize(deserializer)?
+                .into_iter()
+                .map(|(start, end)| (start.0, end.0))
+                .collect())
+        }
+    }
+}
