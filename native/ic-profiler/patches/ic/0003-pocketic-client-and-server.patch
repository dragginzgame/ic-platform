+            "RAM workspace path {} is too long for Unix-domain sockets; select a shorter --ram-dir or POCKET_IC_RAM_DIR",
+            directory.path().display()
+        ));
+    }
+    let info = StorageInfo {
+        ram_backed: true,
+        temporary_directory: directory.path().to_path_buf(),
+    };
+    // SAFETY: The ordinary server calls this before creating the runtime or
