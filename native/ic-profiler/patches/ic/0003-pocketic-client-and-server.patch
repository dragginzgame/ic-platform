+fn validate_instance_state_storage(
+    state_dir: Option<&std::path::Path>,
+    ram: bool,
+) -> Result<(), String> {
+    let Some(state_dir) = state_dir.filter(|_| ram) else {
+        return Ok(());
+    };
+    let absolute = if state_dir.is_absolute() {
+        state_dir.to_path_buf()
+    } else {
+        std::env::current_dir()
+            .map_err(|e| format!("Cannot resolve state directory: {e}"))?
+            .join(state_dir)
+    };
+    // A fresh destination need not exist yet. Its nearest existing ancestor
+    // determines the filesystem on which StateLayout will create it.
+    let mut existing = absolute.as_path();
+    while !existing.exists() {
+        existing = existing
+            .parent()
+            .ok_or_else(|| format!("Cannot resolve state directory {}", state_dir.display()))?;
+    }
+    storage::validate_ram_directory(existing).map_err(|error| format!(
+        "RAM mode requires writable state_dir on executable tmpfs ({}): {error}. Read-only subnet seed paths may remain on disk.", state_dir.display()
+    ))
