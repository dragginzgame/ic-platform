+/// Signed reconciliation values also use decimal strings to preserve their
+/// full range in clients that parse JSON numbers as IEEE 754 doubles.
+pub mod trace_i128 {
+    use serde::{Deserializer, Serializer};
+    use std::fmt;
+
+    pub fn serialize<S: Serializer>(value: &i128, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&value.to_string())
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<i128, D::Error> {
+        struct SignedDecimal;
+
+        impl serde::de::Visitor<'_> for SignedDecimal {
+            type Value = i128;
+
+            fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+                formatter.write_str("a signed decimal integer string or an integer")
+            }
+
+            fn visit_str<E: serde::de::Error>(self, value: &str) -> Result<i128, E> {
+                value.parse().map_err(E::custom)
+            }
+
+            fn visit_i64<E: serde::de::Error>(self, value: i64) -> Result<i128, E> {
+                Ok(i128::from(value))
+            }
+
+            fn visit_u64<E: serde::de::Error>(self, value: u64) -> Result<i128, E> {
+                Ok(i128::from(value))
+            }
+        }
+
+        deserializer.deserialize_any(SignedDecimal)
+    }
+}
