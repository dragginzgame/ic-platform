+    assert!(ram.ram);
+    assert_eq!(ram.ram_dir, Some(PathBuf::from("/dev/shm")));
+    let directory_only = Args::try_parse_from(["pocket-ic", "--ram-dir", "/dev/shm"]).unwrap();
+    assert_eq!(directory_only.ram_dir, Some(PathBuf::from("/dev/shm")));
