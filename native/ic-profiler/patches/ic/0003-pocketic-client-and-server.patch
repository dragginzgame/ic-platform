+fn initialize_storage(args: &Args) -> Result<(Option<tempfile::TempDir>, StorageInfo), String> {
+    let environment_ram = storage::ram_requested_from_env()?;
+    let ram = args.ram || args.ram_dir.is_some() || environment_ram;
