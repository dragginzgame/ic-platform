;; Independent payer and same-subnet fee oracle for the raw Runtime receiver.
(module
  (import "ic0" "cost_create_canister" (func $fee (param i32)))
  (import "ic0" "msg_arg_data_size" (func $size (result i32)))
  (import "ic0" "msg_arg_data_copy" (func $copy (param i32 i32 i32)))
  (import "ic0" "call_new" (func $new (param i32 i32 i32 i32 i32 i32 i32 i32)))
  (import "ic0" "call_cycles_add128" (func $attach (param i64 i64)))
  (import "ic0" "call_data_append" (func $args (param i32 i32)))
  (import "ic0" "call_perform" (func $perform (result i32)))
  (import "ic0" "msg_cycles_refunded128" (func $refund (param i32)))
  (import "ic0" "msg_reject_msg_size" (func $error_size (result i32)))
  (import "ic0" "msg_reject_msg_copy" (func $error_copy (param i32 i32 i32)))
  (import "ic0" "msg_reply_data_append" (func $append (param i32 i32)))
  (import "ic0" "msg_reply" (func $reply))
  (memory (export "memory") 1)
  (data (i32.const 0) "system_probe")
  (table 2 funcref)
  (elem (i32.const 0) $success $rejected)
  (func (export "canister_update fee")
    (call $fee (i32.const 32))
    (call $append (i32.const 32) (i32.const 16))
    (call $reply))
  ;; Argument is a one-byte receiver mode followed by its principal.
  (func (export "canister_update pay")
    (if (i32.gt_u (call $size) (i32.const 30)) (then unreachable))
    (call $copy (i32.const 32) (i32.const 0) (call $size))
    (call $new (i32.const 33) (i32.sub (call $size) (i32.const 1))
      (i32.const 0) (i32.const 12) (i32.const 0) (i32.const 0) (i32.const 1) (i32.const 0))
    (call $args (i32.const 32) (i32.const 1))
    (call $attach (i64.const 1) (i64.const 17))
    (if (call $perform) (then unreachable)))
  (func $report_refund
    (call $refund (i32.const 32))
    (call $append (i32.const 32) (i32.const 16)))
  (func $success (param i32)
    (call $report_refund)
    (call $copy (i32.const 64) (i32.const 0) (call $size))
    (call $append (i32.const 64) (call $size))
    (call $reply))
  (func $rejected (param i32)
    (call $report_refund)
    (call $error_copy (i32.const 64) (i32.const 0) (call $error_size))
    (call $append (i32.const 64) (call $error_size))
    (call $reply)))
