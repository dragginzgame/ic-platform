--- a/ic-cdk/src/macros.rs
+++ b/ic-cdk/src/macros.rs
@@ -2,6 +2,10 @@
 ///
 /// Call this macro only if you want the Candid export behavior.
 /// Only call it once at the end of canister code outside query/update definition.
+///
+/// `export_candid!(path::to::candid)` uses that path for both the service macro
+/// and its generated code. The default is `::candid`. Use the same path as the
+/// entrypoint macros' `candid` option when accessing Candid through a facade.
 pub use ic_cdk_macros::export_candid;
 
 /// Register a query call entry point.
@@ -13,6 +17,12 @@
 ///
 /// ## Basic Usage
 ///
+/// The optional `candid = "path::to::candid"` argument selects the module used
+/// for default argument decoding, reply encoding and service registration.
+/// It defaults to `::candid` and preserves the same decoder configuration.
+/// The module must expose Candid's root codec functions, `DecoderConfig`,
+/// `candid_method` and the service/derive machinery used by the application.
+///
 /// ```rust
 /// # use ic_cdk::query;
 /// #[query]
