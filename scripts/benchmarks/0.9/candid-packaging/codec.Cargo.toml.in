[package]
name = "candid-codec-packaging-probe"
version = "0.0.0"
edition = "2024"
rust-version = "1.91.0"
license = "Apache-2.0"
publish = false
[features]
default = ["bignum"]
bignum = ["candid/bignum"]
value = ["candid/value"]
[dependencies]
candid = { version = "=0.10.39", default-features = false, features = ["bignum", "serde_bytes"] }
anyhow = "1"
hex = "0.4"
leb128 = "0.2"
paste = "1"
serde = { version = "1", features = ["derive"] }
[target.'cfg(not(target_family = "wasm"))'.dependencies]
stacker = "0.1"
[workspace]
