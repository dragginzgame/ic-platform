# Isolated test harness for the provider's exact HTTP admission source.
# Match the native IC workspace's compatible HTTP dependency families.
[workspace]
[package]
name = "platform-http-admission-proof"
version = "0.0.0"
edition = "2024"
rust-version = "1.91"
publish = false

# ── Production dependencies ───────────────────────────────────────────
[dependencies]
axum = "0.8.4"

# ── Development dependencies ──────────────────────────────────────────
[dev-dependencies]
aide = { version = "0.14.2", features = ["axum", "axum-json"] }
tokio = { version = "1.42.0", features = ["macros", "rt-multi-thread"] }
tower = { version = "0.5.2", features = ["util"] }
