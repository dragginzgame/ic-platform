[package]
name = "platform-runtime-canister"
version.workspace = true
edition.workspace = true
publish.workspace = true
rust-version.workspace = true

[features]
timers-composition = []
prepared-call = []
external-candid = ["dep:ic-platform", "ic-platform/candid", "ic-platform/management-canister-types", "ic-platform/raw-rand"]
external-adapters = ["external-candid"@EXTERNAL_BRIDGE@]

[lib]
crate-type = ["cdylib"]

[dependencies]
@TIMERS_CANISTER@
ic-platform = { workspace = true, optional = true }
ic-platform-runtime.workspace = true
ic-wire.workspace = true
serde.workspace = true

[package.metadata.shared-tooling.loc]
category = "tests"
