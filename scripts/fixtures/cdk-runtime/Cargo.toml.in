[workspace]
members = ["crates/canister", "apps/driver"]
resolver = "3"

[workspace.package]
version = "0.0.0"
edition = "2024"
rust-version = "@MSRV@"
publish = false

[workspace.dependencies]
ic-platform = { @PLATFORM@, default-features = false }
ic-platform-runtime = { @RUNTIME@, default-features = false, features = ["cdk"] }
ic-testkit = "@TESTKIT@"
ic-wire = "@WIRE@"
serde = { version = "@SERDE@", default-features = false }
serde_cbor = "@CBOR@"
