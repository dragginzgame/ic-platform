type Account = record { owner : principal; subaccount : opt blob };
type Allowance = record { allowance : nat; expires_at : opt nat64 };
type AllowanceArgs = record { account : Account; spender : Account };
type ArchivedBlocks = record {
  args : vec GetBlocksRequest;
  callback : QueryArchiveFn;
};
type BlockWithId = record { id : nat; block : ICRC3Value };
type ConsentInfo = record {
  metadata : ConsentMessageMetadata;
  consent_message : ConsentMessage;
};
type ConsentMessage = variant {
  FieldsDisplayMessage : FieldsDisplay;
  GenericDisplayMessage : text;
};
type ConsentMessageMetadata = record {
  utc_offset_minutes : opt int16;
  language : text;
};
type ConsentMessageRequest = record {
  arg : blob;
  method : text;
  user_preferences : ConsentMessageSpec;
};
type ConsentMessageSpec = record {
  metadata : ConsentMessageMetadata;
  device_spec : opt DisplayMessageType;
};
type DisplayMessageType = variant { GenericDisplay; FieldsDisplay };
type ErrorInfo = record { description : text };
type ExpectedAccount = Account;
type ExpectedAllowance = Allowance;
type ExpectedAllowanceArgs = AllowanceArgs;
type ExpectedArchivedBlocks = ArchivedBlocks;
type ExpectedBlockWithId = BlockWithId;
type ExpectedConsentInfo = ConsentInfo;
type ExpectedConsentMessage = ConsentMessage;
type ExpectedConsentMessageMetadata = ConsentMessageMetadata;
type ExpectedConsentMessageRequest = ConsentMessageRequest;
type ExpectedConsentMessageSpec = ConsentMessageSpec;
type ExpectedConsentValue = Value_1;
type ExpectedDisplayMessageType = DisplayMessageType;
type ExpectedErrorInfo = ErrorInfo;
type ExpectedFieldsDisplay = FieldsDisplay;
type ExpectedGetArchivesArgs = GetArchivesArgs;
type ExpectedGetBlocksRequest = GetBlocksRequest;
type ExpectedGetBlocksResult = GetBlocksResult;
type ExpectedICRC3ArchiveInfo = ICRC3ArchiveInfo;
type ExpectedICRC3DataCertificate = ICRC3DataCertificate;
type ExpectedICRC3Value = ICRC3Value;
type ExpectedIcrc21Error = Icrc21Error;
type ExpectedMemo = blob;
type ExpectedMetadataValue = MetadataValue;
type ExpectedQueryArchiveFn = func (vec GetBlocksRequest) -> (
    GetBlocksResult,
  ) query;
type ExpectedSupportedBlockType = SupportedBlockType;
type ExpectedTransferArg = TransferArg;
type ExpectedTransferError = TransferError;
type ExpectedValue = Value;
type FieldsDisplay = record {
  fields : vec record { text; Value_1 };
  intent : text;
};
type GetArchivesArgs = record { from : opt principal };
type GetBlocksRequest = record { start : nat; length : nat };
type GetBlocksResult = record {
  log_length : nat;
  blocks : vec BlockWithId;
  archived_blocks : vec ArchivedBlocks;
};
type ICRC3ArchiveInfo = record {
  end : nat;
  canister_id : principal;
  start : nat;
};
type ICRC3DataCertificate = record { certificate : blob; hash_tree : blob };
type ICRC3Value = variant {
  Int : int;
  Map : vec record { text; ICRC3Value };
  Nat : nat;
  Blob : blob;
  Text : text;
  Array : vec ICRC3Value;
};
type Icrc21Error = variant {
  GenericError : record { description : text; error_code : nat };
  InsufficientPayment : ErrorInfo;
  UnsupportedCanisterCall : ErrorInfo;
  ConsentMessageUnavailable : ErrorInfo;
};
type MetadataValue = variant { Int : int; Nat : nat; Blob : blob; Text : text };
type QueryArchiveFn = func (vec record { start : nat; length : nat }) -> (
    record {
      log_length : nat;
      blocks : vec record {
        id : nat;
        block : variant {
          Int : int;
          Map : vec record { text; ICRC3Value };
          Nat : nat;
          Blob : blob;
          Text : text;
          Array : vec ICRC3Value;
        };
      };
      archived_blocks : vec record {
        args : vec record { start : nat; length : nat };
        callback : QueryArchiveFn;
      };
    },
  ) query;
type SupportedBlockType = record { url : text; block_type : text };
type TransferArg = record {
  to : Account;
  fee : opt nat;
  memo : opt blob;
  from_subaccount : opt blob;
  created_at_time : opt nat64;
  amount : nat;
};
type TransferError = variant {
  GenericError : record { message : text; error_code : nat };
  TemporarilyUnavailable;
  BadBurn : record { min_burn_amount : nat };
  Duplicate : record { duplicate_of : nat };
  BadFee : record { expected_fee : nat };
  CreatedInFuture : record { ledger_time : nat64 };
  TooOld;
  InsufficientFunds : record { balance : nat };
};
type Value = variant {
  Int : int;
  Map : vec record { text; Value };
  Nat : nat;
  Nat64 : nat64;
  Blob : blob;
  Text : text;
  Array : vec Value;
};
type Value_1 = variant {
  Text : record { content : text };
  TokenAmount : record { decimals : nat8; amount : nat64; symbol : text };
  TimestampSeconds : record { amount : nat64 };
  DurationSeconds : record { amount : nat64 };
};

