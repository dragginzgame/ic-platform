// External DTO used by typed entrypoints and service extraction.
type Message = record {
  // Original caller-supplied principal.
  owner : principal;
  // Arbitrary-precision external amount.
  amount : nat;
};
service : (nat64) -> {
  awaited : (nat64) -> (nat64);
  callback_trap : () -> ();
  cleaned : () -> (nat64) query;
  composite : (nat64) -> (nat64) composite_query;
  controller : () -> (bool) query;
  dto : (Message) -> (Message) query;
  guarded : () -> (nat64) query;
  migratory : () -> ();
  missing : () -> (bool);
  protected_pending : () -> ();
  scalar : (nat64) -> (nat64) query;
  tuple : () -> (nat64, bool) query;
  unit : () -> () query;
  value : () -> (nat64) query;
}