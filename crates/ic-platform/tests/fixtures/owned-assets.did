type GetArgs = record { key : text; accept_encodings : vec text };
type GetResult = record {
  content : vec nat8;
  content_type : text;
  content_encoding : text;
  sha256 : opt vec nat8;
  total_length : nat;
};
type GetChunkArgs = record { key : text; content_encoding : text; index : nat; sha256 : opt vec nat8 };
type GetChunkResult = record { content : vec nat8 };
service : {
  get : (GetArgs) -> (GetResult) query;
  get_chunk : (GetChunkArgs) -> (GetChunkResult) query;
}
